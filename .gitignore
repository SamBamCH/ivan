# environments / secrets
/venv
/node_modules
.env

# python
__pycache__/
*.pyc

# local data, models, solver binaries, browser profiles (machine-specific)
/data
/models
/GLPK
/glpk-4.65
/chrome-selenium
google-chrome-stable_current_amd64.deb

